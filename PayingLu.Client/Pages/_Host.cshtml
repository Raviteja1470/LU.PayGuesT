@page "/"
@namespace PayingLu.Client.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>PayingLu</title>
    <base href="~/" />
    <link href="css/app.css" rel="stylesheet" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <!-- Include the cookie helpers before Blazor's runtime so setCookie is available when C# calls JS -->
    <script src="~/js/cookies.js"></script>

    <!-- Blazor runtime: keep existing framework script reference (example shown; keep yours if different) -->
    <script src="_framework/blazor.server.js"></script>
</body>
</html>