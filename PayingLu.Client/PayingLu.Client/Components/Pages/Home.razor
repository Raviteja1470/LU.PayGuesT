@page "/"
@using System.Security.Claims
@using Microsoft.IdentityModel.JsonWebTokens

@attribute [Authorize]

@inject JWTAuthenticationStateProvider AuthStateProvider
@inject AccessTokenService AccessTokenService
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<AuthorizeView>
    <h1>
        You are authorize!
        <button class="btn btn-primary ms-3" @onclick="Logout">Logout</button>
    </h1>

    <hr />

    <h3>User Information:</h3>

    <table>
        <tr>
            <td style="width:200px">Email</td>
            <td>@Email</td>
        </tr>

        <tr>
            <td>Role</td>
            <td>@Role</td>
        </tr>

        <tr>
            <td>Access Token</td>
            <td class="td-value">@Token</td>
        </tr>

        <tr>
            <td>Date Time Expired</td>
            <td>@TokenExpired</td>
        </tr>

        <tr>
            <td>Date Time Now</td>
            <td>@currentTime</td>
        </tr>
    </table>
</AuthorizeView>

<style>
    table {
        width: 100%;
        max-width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        margin-top: 15px;
    }

    td {
        padding: 10px;
        border: 1px solid #ddd;
        word-wrap: break-word;
        overflow-wrap: break-word;
        font-size: 16px;
    }

    .td-value {
        color: #333;
        font-weight: 500;
    }
</style>

@code {
    public string Email { get; set; } = "";
    public string Role { get; set; } = "";
    public string Token { get; set; } = "";
    public DateTime TokenExpired { get; set; }
    public DateTime currentTime { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
    }

    private async Task LoadUserInfo()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Load token from cookie
            Token = await AccessTokenService.GetToken();

            // Claims
            Email = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
            Role = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;

            // Expiration
            var exp = user.Claims.FirstOrDefault(c => c.Type == JwtRegisteredClaimNames.Exp)?.Value;

            if (long.TryParse(exp, out var expUnix))
            {
                TokenExpired = DateTimeOffset.FromUnixTimeSeconds(expUnix).LocalDateTime;
            }

            // Current time
            currentTime = DateTime.Now;
        }
    }

    private async Task Logout()
    {
        await AccessTokenService.RemoveToken();
        // AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", true);
    }
}