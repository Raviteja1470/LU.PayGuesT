@page "/login"
@layout EmptyLayout

@rendermode InteractiveServer

@inject AuthService AuthService
@inject NavigationManager nav

<style>
    body {
        background: linear-gradient(to bottom, #0d1b4c, #5a2a7a);
        height: 100vh;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
    }

    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .login-card {
        width: 380px;
        background: white;
        padding: 35px 30px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        text-align: center;
    }

    .avatar {
        width: 90px;
        height: 90px;
        background: #e9ecef;
        border-radius: 50%;
        margin: 0 auto 20px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        color: #6c757d;
    }

    .login-input {
        height: 48px;
        font-size: 16px;
    }

    .login-btn {
        height: 48px;
        font-size: 18px;
        font-weight: 600;
    }
</style>

<div class="login-wrapper">

    <div class="login-card">

        <div class="avatar">
            <span class="bi bi-person"></span>
        </div>

        <h3 class="mb-4">Sign in to continue</h3>

        <input type="text"
               @bind-value="Email"
               @bind-value:event="oninput"
               class="form-control login-input mb-3"
               placeholder="Email"
               autofocus />

        <input type="password"
               @bind-value="Password"
               @bind-value:event="oninput"
               class="form-control login-input mb-3"
               placeholder="Password" />

        <button class="btn btn-primary w-100 login-btn"
                disabled="@IsLoading"
                @onclick="OnLogin">
            @(IsLoading ? "Signing in..." : "Sign in")
        </button>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3">@ErrorMessage</div>
        }
    </div>
</div>

@code {
    public string Email { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;
    public string? ErrorMessage { get; set; }
    public bool IsLoading { get; set; }

    private async Task OnLogin()
    {
        ErrorMessage = null;
        IsLoading = true;

        var status = await AuthService.Login(Email, Password);


        IsLoading = false;

        if (status)
        {
            nav.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Invalid email or password.";
        }
    }
}