@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer

@inject AuthService AuthService
@inject NavigationManager nav

<style>
    .login-bg {
        min-height: 100vh;
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .login-card {
        width: 380px;
        background: #ffffff;
        border-radius: 14px;
        padding: 35px 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        text-align: center;
    }

    .login-title {
        font-size: 26px;
        font-weight: 600;
        margin-bottom: 20px;
        color: #333;
    }

    /* PERFECT FIT PROFILE ICON */
    .login-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: #f5f5f5;
        padding: 10px;
        margin-bottom: 15px;
        border: 2px solid #e0e0e0;
        /* Ensures perfect fit */
        object-fit: contain; /* shows full image */
        object-position: center;
    }

    .profile-title {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 4px;
        color: #222;
    }

    .profile-sub {
        font-size: 14px;
        color: #666;
        margin-bottom: 20px;
    }

    .input-group {
        position: relative;
        margin-bottom: 15px;
    }

    .input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: #777;
    }

    .login-input {
        padding-left: 40px;
        height: 45px;
    }

    .login-btn {
        margin-top: 10px;
        font-size: 18px;
        padding: 10px;
    }
</style>

<div class="login-bg">
    <div class="login-card">

        <h1 class="login-title">Sign in to continue</h1>

        <img class="login-avatar"
             src="Images/PayGluICON.png"
             alt="profile" />

        <div class="profile-title">Profile</div>
        <div class="profile-sub">Manage your account information</div>

        <div class="input-group">
            <span class="input-icon">📧</span>
            <input type="text"
                   @bind-value="Email"
                   class="form-control login-input"
                   placeholder="Email"
                   required />
        </div>

        <div class="input-group">
            <span class="input-icon">🔒</span>
            <input type="password"
                   @bind-value="Password"
                   class="form-control login-input"
                   placeholder="Password"
                   required />
        </div>

        <button class="btn btn-primary w-100 login-btn"
                @onclick="OnLogin">
            Sign in
        </button>

    </div>
</div>

@code {
    public string Email { get; set; }
    public string Password { get; set; }

    private async Task OnLogin()
    {
        var status = await AuthService.Login(Email, Password);

        if (status)
        {
            nav.NavigateTo("/");
        }
    }
}